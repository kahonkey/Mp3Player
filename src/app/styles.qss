*{
    padding: 0px;
    margin: 0px;
    background: #536C84; 
}

QPushButton#songButton {
    padding: 0px;
    border: none;
    background-color: #3B4D5E;
    text-align: left;
}

TitleBar {
    width: 100%;
    height: 45px;
}

#titleBar * {
    background: #4A6176;
    border: none;
}

#titleAndSongs {
    width: 50%;
}

PlaylistViewer {
    background-color: #3B4D5E;
}

/* More specific selector for SongController */
 SongInfo {
}

SongInfo, SongInfo * {
    background: #1A232B;
}

#songName{
    font-size: 15px;
}

#albumName{
    font-size: 9px;
    color: #94B0CC;
}

#songInfoImage{
    height: 50px;
    width: 50px;
}


QLineEdit {
    border: none;
}

#controllerButton{
    border: none;

}

QSlider::handle:horizontal{
    background: transparent;
    border: 0px solid transparent;
    width: 0px;
    height: 0px;
}

QSlider::groove:horizontal{
    background-color: #D9D9D9;
    border: 0px solid transparent;
    height: 2px;
}

QSlider::sub-page:horizontal{
    background-color: #536C84;
    border: 0px solid transparent;
    height: 2px;
}

#volumeSlider{
    max-width: 100px;
}